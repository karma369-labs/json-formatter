# JSONSpace — Apache config for Namecheap shared hosting.
# Vite copies everything in public/ into dist/, so this ships to public_html.
#
# Goal: one canonical URL per page (https + www + no trailing slash), each tool
# served from its own prerendered dist/<path>/index.html, and any unknown path
# answered with a real 404 status and the prerendered 404 page.

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the www host in a single external 301. Runs first so the
  # canonical host is settled before any internal rewrite below.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.jsonspace.io%{REQUEST_URI} [L,R=301]

  # /index.html and /validator/index.html are the same pages as / and
  # /validator, so send them to the one canonical URL. THE_REQUEST is the
  # browser's own request line, which the internal index.html rewrite below
  # never changes, so these can't loop.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/(.+)/index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Drop trailing slashes (except the root) so /validator/ 301s to /validator,
  # matching the no-trailing-slash canonical tags the prerender stamps in.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve the prerendered file for a clean URL without redirecting, e.g.
  # /validator -> /validator/index.html. Keeps the address bar on /validator.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]

  # Anything left that isn't a real file has no page, so answer 404. Serving
  # the home page with a 200 here made every typo URL look like a duplicate of
  # the home page to search engines. This also covers folders with no page of
  # their own, such as /converter and /assets.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

# Hashed asset filenames are immutable — cache them hard. HTML is regenerated
# each deploy, so it must always be revalidated.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
